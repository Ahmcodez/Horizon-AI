# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets here or anywhere else.

# Firebase project config (from Firebase Console > Project Settings > General
# > Your apps > SDK setup and configuration). These are client-side config
# values, not server secrets — they're safe to expose in a built frontend
# bundle, but we still keep them out of source control so different
# environments (dev/staging/prod) can point at different Firebase projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-side only (set via Firebase Secret Manager, NOT in this file) ---
# The Anthropic API key that powers the AI assistant lives only in
# functions/ via `firebase functions:secrets:set ANTHROPIC_API_KEY` —
# it is never read from a .env file and never shipped to the browser.
