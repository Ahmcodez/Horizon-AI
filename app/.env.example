# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets here or anywhere else.

# Anthropic API key (used for the AI assistant, document reader, and
# rule-change summary generation — added in a later phase)
# ANTHROPIC_API_KEY=

# Database connection string (added when accounts/persistence are built)
# DATABASE_URL=

# Auth provider secret (added with the accounts phase)
# AUTH_SECRET=
