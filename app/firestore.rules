rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read or write their own profile document.
    // uid comes from the authenticated Firebase user's token, not from
    // anything the client sends in the request body, so it can't be spoofed.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Subscription/plan status. Readable by the owning user so the UI can
    // reflect their plan, but never writable from the client - only the
    // Stripe webhook (via the Admin SDK, which bypasses these rules
    // entirely) is allowed to change what plan someone is actually on.
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Personalized rule-change alerts. Users can read, mark-as-read, or
    // dismiss (delete) their own alerts, but cannot create one - alerts are
    // only ever written by the scheduled checkRuleUpdates function via the
    // Admin SDK.
    match /profiles/{uid}/alerts/{alertId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if false;
    }

    // Internal rule-monitoring state - not exposed to any client at all.
    match /ruleSources/{sourceId} {
      allow read, write: if false;
    }
    match /ruleUpdates/{updateId} {
      allow read, write: if false;
    }

    // General daily news digest (see scripts/daily-news) - readable by any
    // signed-in user, written only by the Admin SDK script (which bypasses
    // these rules entirely), never by a client.
    match /dailyDigest/{digestId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Advisor multi-client dashboard. Only the advisor themselves can
    // access their own client list, and only if they actually hold an
    // 'advisor' plan right now - checked server-side via a get() against
    // their own customers doc, not just trusted from the client's request.
    // This means even if someone's UI is tampered with, a non-advisor
    // account still can't read or write client records.
    match /advisorClients/{advisorUid}/clients/{clientId} {
      allow read, write: if request.auth != null
        && request.auth.uid == advisorUid
        && get(/databases/$(database)/documents/customers/$(advisorUid)).data.plan == 'advisor';
    }

    // Advisor lead-generation / matching directory. Any signed-in user can
    // browse advisor profiles (so a Plan-tier client can find someone to
    // match with), but a profile is only writable by the advisor it
    // belongs to, and only while they actually hold the 'advisor' plan
    // right now - same server-checked get() pattern as advisorClients above.
    match /advisorProfiles/{advisorUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == advisorUid
        && get(/databases/$(database)/documents/customers/$(advisorUid)).data.plan == 'advisor';
    }

    // Client <-> advisor matches formed through in-app advisor matching.
    // A match can only be created by the client it's for, who must
    // currently hold a paying plan ('plan' or 'advisor'), and must be
    // created against an account that currently actually holds the
    // 'advisor' plan (so a client can't fabricate a match against an
    // arbitrary uid). Once created, only the two participants named on the
    // document can read or update it - field-level write restrictions
    // aren't enforced beyond that, consistent with this project's existing
    // trust level for two-party documents (see advisorClients above): both
    // sides are already authenticated, paying/verified accounts.
    match /matches/{matchId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.clientUid || request.auth.uid == resource.data.advisorUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.clientUid
        && get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.plan in ['plan', 'advisor']
        && get(/databases/$(database)/documents/customers/$(request.resource.data.advisorUid)).data.plan == 'advisor';
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.clientUid || request.auth.uid == resource.data.advisorUid);
      allow delete: if false;

      // Message thread for one match. Same two-participant rule, checked
      // against the parent match document since a message doesn't carry
      // clientUid/advisorUid itself. Messages are append-only - once sent,
      // a message can't be edited or deleted by either side.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.clientUid
              || request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.advisorUid);
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderUid
          && (request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.clientUid
              || request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.advisorUid);
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
