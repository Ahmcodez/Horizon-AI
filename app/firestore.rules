rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read or write their own profile document.
    // uid comes from the authenticated Firebase user's token, not from
    // anything the client sends in the request body, so it can't be spoofed.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Subscription/plan status. Readable by the owning user so the UI can
    // reflect their plan, but never writable from the client - only the
    // Stripe webhook (via the Admin SDK, which bypasses these rules
    // entirely) is allowed to change what plan someone is actually on.
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
