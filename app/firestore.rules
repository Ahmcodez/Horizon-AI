rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read or write their own profile document.
    // uid comes from the authenticated Firebase user's token, not from
    // anything the client sends in the request body, so it can't be spoofed.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
