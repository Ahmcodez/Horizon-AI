# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets here or anywhere else.

# Firebase project config (from Firebase Console > Project Settings > General
# > Your apps > SDK setup and configuration). These are client-side config
# values, not server secrets — they're safe to expose in a built frontend
# bundle, but we still keep them out of source control so different
# environments (dev/staging/prod) can point at different Firebase projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local testing only ---
# Set to true in your own .env.local to unlock every paid feature (household
# panel, state comparison, document reader, scenarios, advisor dashboard,
# embed widget) without a real Stripe subscription. Purely a client-side
# read override in lib/billing.ts — never touches Firestore or Stripe, and
# has no effect unless you set it yourself. Leave unset/false for anything
# resembling a real deployment; a small "dev-unlocked" tag shows in the nav
# whenever it's on, so it's obvious when it's active.
VITE_DEV_UNLOCK_ALL=

# --- Server-side only (set via Firebase Secret Manager, NOT in this file) ---
# The Gemini API key that powers the AI assistant, document reader, and
# rule-change monitoring lives only in functions/ via
# `firebase functions:secrets:set GEMINI_API_KEY` — it is never read from a
# .env file and never shipped to the browser.
#
# NOTE: this app currently uses Gemini's free tier. On free tier, Google's
# terms allow using prompts/responses (which include real users' benefit
# data and uploaded documents) to improve their models — worth disclosing
# in your privacy policy while on free tier, and worth moving to a paid
# tier before relying on this for real users at any real volume, since the
# free tier's rate limit (~10-15 requests/minute, shared across the whole
# app) is easy to hit with more than a handful of simultaneous users.

# --- Stripe (server-side only, set via Firebase, NOT in this file) ---
# Set these on the functions side:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# STRIPE_PRICE_PLAN_ID and STRIPE_PRICE_ADVISOR_ID are config (not secret) -
# set them as environment params for the functions deploy, e.g. in
# functions/.env.<project-id> (git-ignored) — see Firebase's docs on
# parameterized configuration for 2nd-gen functions.
